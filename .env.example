# Konfigurasi opsional untuk docker-compose.yml.
# Docker Compose otomatis membaca file `.env` di folder ini.
# Salin ke `.env` HANYA jika ingin mengubah nilai default di bawah.
#
#   cp .env.example .env
#
# Tanpa file .env pun `docker compose up` tetap jalan dengan nilai default.

APP_NAME=SAFRONS API
APP_ENV=local
DEBUG=true
API_V1_PREFIX=/api/v1

# React + Vite dev server origins
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Docker Compose database defaults.
# Docker Compose automatically reads `.env` from this folder.
POSTGRES_USER=safrons
POSTGRES_PASSWORD=safrons
POSTGRES_DB=safrons

# Host port for PostgreSQL. Change this if 5432 is already used.
DB_PORT=5432

# PostgreSQL/PostGIS connection for the FastAPI app.
DATABASE_URL=postgresql+psycopg://safrons:safrons@localhost:5436/safrons

# JWT auth. Replace this value outside local development.
JWT_SECRET_KEY=change-this-local-development-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
